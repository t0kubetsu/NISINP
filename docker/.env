# =============================================================================
# NISINP / Governance Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Variables marked [REQUIRED] have no default and must be set before starting.
# Variables marked [OPTIONAL] fall back to sensible defaults if omitted.
# =============================================================================


# -----------------------------------------------------------------------------
# Docker / Compose
# -----------------------------------------------------------------------------

# Deployment environment label — used as a suffix for container names.
# [REQUIRED] Examples: dev, staging, production
NISINP_ENVIRONMENT=dev

# Docker image to use for the web, celery-worker and celery-beat services.
# [OPTIONAL] Defaults to the official upstream image.
NISINP_IMAGE=ghcr.io/informed-governance-project/nisinp

# Image tag / version to pull.
# [REQUIRED] Example: latest, 1.2.3
NISINP_VERSION=latest

# Docker image for the theme sidecar container.
# [OPTIONAL] Defaults to the official default theme.
THEME_IMAGE=ghcr.io/informed-governance-project/default-theme

# Theme image tag / version to pull.
# [REQUIRED]
THEME_VERSION=latest


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Password for the PostgreSQL user.
# [REQUIRED]
POSTGRES_PASSWORD=change_me

# Database host. Use "postgres" when running via docker-compose, "localhost"
# when running Django locally against the dev compose stack.
# [OPTIONAL] Default: localhost
POSTGRES_HOST=postgres

# Database port.
# [OPTIONAL] Default: 5432
POSTGRES_PORT=5432

# Database name.
# [OPTIONAL] Default: governanceplatform
POSTGRES_DB=governanceplatform

# Database user.
# [OPTIONAL] Default: governanceplatform
POSTGRES_USER=governanceplatform


# -----------------------------------------------------------------------------
# Cache / Message Broker (Redis)
# -----------------------------------------------------------------------------

# Celery broker URL — Redis database 0.
# [OPTIONAL] Default: redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend — Redis database 1.
# [OPTIONAL] Default: redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Enable Django debug mode. Never set to "true" in production.
# [OPTIONAL] Default: false
DEBUG=false

# Public hostname or IP of the instance (added to ALLOWED_HOSTS).
# [OPTIONAL] Example: nisinp.example.org
PUBLIC_URL=

# Canonical site URL — used in e-mail links and API responses.
# [OPTIONAL] Example: https://nisinp.example.org
MAIN_SITE=

# Human-readable name shown in the UI.
# [OPTIONAL] Example: "My Governance Platform"
MAIN_SITE_NAME=


# -----------------------------------------------------------------------------
# Superuser bootstrapping (first-run only)
# -----------------------------------------------------------------------------
# If both variables are set, a Django superuser is created automatically on
# the first container start. Leave blank to skip automatic creation.

# [OPTIONAL]
SUPERUSER_EMAIL=

# [OPTIONAL]
SUPERUSER_PASSWORD=
